# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL + PostGIS + pgvector)
DATABASE_URL=postgresql+psycopg://eriwatch:eriwatch_local@localhost:5432/eriwatch
POSTGRES_USER=eriwatch
POSTGRES_PASSWORD=eriwatch_local
POSTGRES_DB=eriwatch
POSTGRES_PORT=5432

# API Security & Auth
JWT_SECRET_KEY=change-me-in-production-to-a-32-byte-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PII_ENCRYPTION_KEY=change-me-32-byte-base64-fernet-key-example=

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM / RAG Providers (Optional in local dev; required for live LLM inference)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# n8n Automation
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=eriwatch_n8n_local
WEBHOOK_SECRET=eriwatch_webhook_secret_local
