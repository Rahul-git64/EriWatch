# Data (ignore raw/interim/processed large files, keep manifests and small samples)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
!data/raw/legal/
data/raw/legal/*.pdf
!data/raw/legal/manifest.json
!data/raw/samples/
data/interim/*
!data/interim/.gitkeep
!data/interim/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
!data/processed/tank_registry.geojson
!data/processed/cloud_stats.parquet
!data/processed/samples/
!data/processed/legal_text/

# Model artifacts (heavy binaries ignored; small metadata kept)
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.h5

# Geospatial & Rasters
*.tif
*.tiff
*.nc
*.gpkg
!tests/fixtures/*.tif

# IDEs & OS
.vscode/
.idea/
*.swp
*.swo
